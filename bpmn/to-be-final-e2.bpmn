  <bpmn:process id="proc_tobe" name="Planificación de rutas y carga, autoventa y control" isExecutable="false">
    <bpmn:laneSet id="laneset"><bpmn:lane id="lane_dueno" name="Dueño / operador de ruta"><bpmn:flowNodeRef>t_revisar</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_ajuste</bpmn:flowNodeRef><bpmn:flowNodeRef>t_ajustar</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_ajuste_m</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_dia_ruta</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cargar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_visitar</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_disp</bpmn:flowNodeRef><bpmn:flowNodeRef>t_vender</bpmn:flowNodeRef><bpmn:flowNodeRef>t_incidencia</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_disp_m</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_quedan</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cuadrar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_caja</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_fin_dia</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_sig" name="SIG (SQLite + n8n)"><bpmn:flowNodeRef>ev_domingo</bpmn:flowNodeRef><bpmn:flowNodeRef>t_importar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_demanda</bpmn:flowNodeRef><bpmn:flowNodeRef>t_seleccion</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef><bpmn:flowNodeRef>t_plan</bpmn:flowNodeRef><bpmn:flowNodeRef>t_alertas</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef><bpmn:flowNodeRef>t_publicar</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_mes</bpmn:flowNodeRef><bpmn:flowNodeRef>t_meta</bpmn:flowNodeRef><bpmn:flowNodeRef>t_reporte</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_fin_mes</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="ev_domingo" name="Domingo 19:00"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition id="td_ev_domingo" /></bpmn:startEvent><bpmn:serviceTask id="t_importar" name="Importar ventas exportadas desde Bicom [n8n 1]"><bpmn:documentation>Requerimientos: RF1</bpmn:documentation><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:property id="prop_t_importar_0" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="da_t_importar_0"><bpmn:sourceRef>ds_bicom</bpmn:sourceRef><bpmn:targetRef>prop_t_importar_0</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="da_t_importar_1"><bpmn:targetRef>ds_sig</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:serviceTask id="t_demanda" name="Calcular demanda esperada por cliente y SKU [n8n 2]"><bpmn:documentation>Requerimientos: RF2</bpmn:documentation><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_seleccion" name="Seleccionar clientes a visitar (reagenda visitas fallidas) [n8n 2]"><bpmn:documentation>Requerimientos: RF3, RF4</bpmn:documentation><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:property id="prop_t_seleccion_2" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="da_t_seleccion_2"><bpmn:sourceRef>ds_sig</bpmn:sourceRef><bpmn:targetRef>prop_t_seleccion_2</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask><bpmn:parallelGateway id="gw_split" name=""><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:parallelGateway><bpmn:serviceTask id="t_plan" name="Generar plan de carga con capacidad del furgón [n8n 2]"><bpmn:documentation>Requerimientos: RF5, RF6</bpmn:documentation><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:dataOutputAssociation id="da_t_plan_3"><bpmn:targetRef>ds_sig</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:serviceTask id="t_alertas" name="Detectar clientes con caída de frecuencia [n8n 2]"><bpmn:documentation>Requerimientos: RF9</bpmn:documentation><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:dataOutputAssociation id="da_t_alertas_4"><bpmn:targetRef>ds_sig</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:parallelGateway id="gw_join" name=""><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:parallelGateway><bpmn:sendTask id="t_publicar" name="Publicar hoja de ruta y orden de carga por correo [n8n 3-5]"><bpmn:documentation>Requerimientos: RF7</bpmn:documentation><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:sendTask><bpmn:startEvent id="ev_mes" name="Día 1 de cada mes"><bpmn:outgoing>f28</bpmn:outgoing><bpmn:timerEventDefinition id="td_ev_mes" /></bpmn:startEvent><bpmn:serviceTask id="t_meta" name="Calcular cumplimiento de meta +30 % [n8n mensual]"><bpmn:documentation>Requerimientos: RF8</bpmn:documentation><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing><bpmn:property id="prop_t_meta_5" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="da_t_meta_5"><bpmn:sourceRef>ds_sig</bpmn:sourceRef><bpmn:targetRef>prop_t_meta_5</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask><bpmn:sendTask id="t_reporte" name="Enviar reporte de cumplimiento al dueño [n8n mensual]"><bpmn:documentation>Requerimientos: RF8</bpmn:documentation><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="ev_fin_mes" name="Reporte enviado"><bpmn:incoming>f30</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="t_revisar" name="Revisar plan sugerido"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="gw_ajuste" name="¿Requiere ajustes?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="t_ajustar" name="Ajustar y aprobar plan en el SIG"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="gw_ajuste_m" name=""><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:intermediateCatchEvent id="ev_dia_ruta" name="Día de ruta (lun-mié-vie-sáb)"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:timerEventDefinition id="td_ev_dia_ruta" /></bpmn:intermediateCatchEvent><bpmn:manualTask id="t_cargar" name="Cargar furgón según orden de carga"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:manualTask><bpmn:userTask id="t_visitar" name="Visitar siguiente cliente de la hoja de ruta"><bpmn:documentation>Requerimientos: RF10</bpmn:documentation><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="gw_disp" name="¿Disponible, con saldo y requiere reposición?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="t_vender" name="Atender, emitir documento en Bicom y despachar"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:dataOutputAssociation id="da_t_vender_6"><bpmn:targetRef>ds_bicom_app</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:userTask id="t_incidencia" name="Registrar incidencia de visita (el SIG la reagenda)"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="gw_disp_m" name=""><bpmn:incoming>f21</bpmn:incoming><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="gw_quedan" name="¿Quedan clientes en la hoja de ruta?"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing><bpmn:outgoing>f25</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="t_cuadrar" name="Cuadrar carga devuelta vs. vendido"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="t_caja" name="Cierre de caja diario"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="ev_fin_dia" name="Jornada cerrada"><bpmn:incoming>f27</bpmn:incoming></bpmn:endEvent><bpmn:dataStoreReference id="ds_bicom" name="ERP Bicom (exportación CSV)" /><bpmn:dataStoreReference id="ds_sig" name="BD SIG (SQLite)" /><bpmn:dataStoreReference id="ds_bicom_app" name="App Bicom (terreno)" /><bpmn:sequenceFlow id="f1" sourceRef="ev_domingo" targetRef="t_importar" /><bpmn:sequenceFlow id="f2" sourceRef="t_importar" targetRef="t_demanda" /><bpmn:sequenceFlow id="f3" sourceRef="t_demanda" targetRef="t_seleccion" /><bpmn:sequenceFlow id="f4" sourceRef="t_seleccion" targetRef="gw_split" /><bpmn:sequenceFlow id="f5" sourceRef="gw_split" targetRef="t_plan" /><bpmn:sequenceFlow id="f6" sourceRef="gw_split" targetRef="t_alertas" /><bpmn:sequenceFlow id="f7" sourceRef="t_plan" targetRef="gw_join" /><bpmn:sequenceFlow id="f8" sourceRef="t_alertas" targetRef="gw_join" /><bpmn:sequenceFlow id="f9" sourceRef="gw_join" targetRef="t_publicar" /><bpmn:sequenceFlow id="f10" sourceRef="t_publicar" targetRef="t_revisar" /><bpmn:sequenceFlow id="f11" sourceRef="t_revisar" targetRef="gw_ajuste" /><bpmn:sequenceFlow id="f12" name="sí" sourceRef="gw_ajuste" targetRef="t_ajustar" /><bpmn:sequenceFlow id="f13" name="no" sourceRef="gw_ajuste" targetRef="gw_ajuste_m" /><bpmn:sequenceFlow id="f14" sourceRef="t_ajustar" targetRef="gw_ajuste_m" /><bpmn:sequenceFlow id="f15" sourceRef="gw_ajuste_m" targetRef="ev_dia_ruta" /><bpmn:sequenceFlow id="f16" sourceRef="ev_dia_ruta" targetRef="t_cargar" /><bpmn:sequenceFlow id="f17" sourceRef="t_cargar" targetRef="t_visitar" /><bpmn:sequenceFlow id="f18" sourceRef="t_visitar" targetRef="gw_disp" /><bpmn:sequenceFlow id="f19" name="sí" sourceRef="gw_disp" targetRef="t_vender" /><bpmn:sequenceFlow id="f20" name="no" sourceRef="gw_disp" targetRef="t_incidencia" /><bpmn:sequenceFlow id="f21" sourceRef="t_vender" targetRef="gw_disp_m" /><bpmn:sequenceFlow id="f22" sourceRef="t_incidencia" targetRef="gw_disp_m" /><bpmn:sequenceFlow id="f23" sourceRef="gw_disp_m" targetRef="gw_quedan" /><bpmn:sequenceFlow id="f24" name="sí" sourceRef="gw_quedan" targetRef="t_visitar" /><bpmn:sequenceFlow id="f25" name="no" sourceRef="gw_quedan" targetRef="t_cuadrar" /><bpmn:sequenceFlow id="f26" sourceRef="t_cuadrar" targetRef="t_caja" /><bpmn:sequenceFlow id="f27" sourceRef="t_caja" targetRef="ev_fin_dia" /><bpmn:sequenceFlow id="f28" sourceRef="ev_mes" targetRef="t_meta" /><bpmn:sequenceFlow id="f29" sourceRef="t_meta" targetRef="t_reporte" /><bpmn:sequenceFlow id="f30" sourceRef="t_reporte" targetRef="ev_fin_mes" /><bpmn:textAnnotation id="ann_n8n"><bpmn:text>Ciclos semanal y mensual automatizados con el flujo n8n "Plan semanal de rutas y carga" (automatizacion/n8n_plan_semanal_emy.json). [n8n k] = nodo que ejecuta la tarea.</bpmn:text></bpmn:textAnnotation><bpmn:association id="as_n8n" sourceRef="ann_n8n" targetRef="t_importar" />
